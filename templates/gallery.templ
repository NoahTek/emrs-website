package templates

import (
	"github.com/NoahTek/emrs-website/internal/database"
	"strconv"

	// Import each component package individually
	"github.com/NoahTek/emrs-website/templates/components/button"
	"github.com/NoahTek/emrs-website/templates/components/card"
	"github.com/NoahTek/emrs-website/templates/components/dialog"
	"github.com/NoahTek/emrs-website/templates/components/form"
	"github.com/NoahTek/emrs-website/templates/components/input"
	"github.com/NoahTek/emrs-website/templates/components/label"
)

// Gallery is the main page view that brings the Dialog and Grid together
templ Gallery(photos []database.PhotoRecord, isAdmin bool) {
	@BaseLayout("Gallery", isAdmin) {
		<div class="max-w-7xl mx-auto px-4 sm:px-6 mt-8">
			<div class="flex justify-between items-center mb-8">
				<h1 class="text-3xl font-bold text-foreground">EMRS Photo Gallery</h1>
				if isAdmin {
					@dialog.Dialog() {
						@dialog.Trigger() {
							@button.Button(button.Props{}) {
								Add New Photo
							}
						}
						@dialog.Content() {
							@dialog.Header() {
								@dialog.Title() {
									Upload a New Photo
								}
								@dialog.Description() {
									Select an image file to add to the school gallery.
								}
							}
							@UploadForm()
						}
					}
				}
			</div>
			@GalleryGrid(photos, isAdmin)
		</div>
	}
}

// GalleryCard generates a single image component
templ GalleryCard(item database.PhotoRecord, isAdmin bool) {
	@card.Card(card.Props{
		// overflow-hidden prevents the image from breaking out of the rounded top corners
		Class: "overflow-hidden bg-accent",
		// Assign a unique ID to the card so HTMX can target it perfectly
		Attributes: templ.Attributes{
			"id": "photo-" + strconv.Itoa(item.ID),
		},
	}) {
		<img src={ item.ImageURL } alt={ item.Title } class="w-full h-48 object-cover"/>
		@card.Header() {
			@card.Title() {
				{ item.Title }
			}
		}
		@card.Footer() {
			<div class="flex justify-between items-center w-full mt-2">
				<span class="text-xs text-accent-foreground">ID: { strconv.Itoa(item.ID) }</span>
				if isAdmin {
					@button.Button(button.Props{
						Variant: button.VariantDestructive,
						Attributes: templ.Attributes{
							"hx-delete":  string(templ.URL("/admin/photo/" + strconv.Itoa(item.ID))),
							"hx-confirm": "Are you sure you want to delete this photo?",
							"hx-target":  "#photo-" + strconv.Itoa(item.ID),
							"hx-swap":    "outerHTML",
						},
					}) {
						Delete
					}
				}
			</div>
		}
	}
}

// GalleryGrid is a container that loops through multiple items
templ GalleryGrid(items []database.PhotoRecord, isAdmin bool) {
	<div id="gallery-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
		for _, item := range items {
			@GalleryCard(item, isAdmin)
		}
	</div>
}

// UploadForm generates the UI for staff to upload new photos inside the modal
templ UploadForm() {
	@form.Item(form.ItemProps{
		Class: "space-y-4",
		Attributes: templ.Attributes{
			"hx-post":     "/admin/upload",
			"hx-encoding": "multipart/form-data",
			"hx-target":   "#gallery-grid",
			"hx-swap":     "afterbegin",
		},
	}) {
		<div class="space-y-2">
			@label.Label(label.Props{For: "title"}) {
				Event Title
			}
			@input.Input(input.Props{
				ID:          "title",
				Name:        "title",
				Placeholder: "e.g., Annual Sports Meet",
				Required:    true,
				Type:        input.TypeText,
			})
		</div>
		<div class="space-y-2">
			@label.Label(label.Props{For: "photo"}) {
				Photo
			}
			@input.Input(input.Props{
				ID:         "photo",
				Name:       "photo",
				Type:       input.TypeFile,
				FileAccept: "image/*",
				Required:   true,
			})
		</div>
		<div class="pt-4 flex justify-end">
			@button.Button(button.Props{
				Type: button.TypeSubmit,
			}) {
				Upload Photo
			}
		</div>
	}
}

// LoginPage wraps LoginForm with the full BaseLayout
templ LoginPage() {
	@BaseLayout("EMRS - Login", false) {
		<div class="max-w-md mx-auto mt-16">
			@LoginForm()
		</div>
	}
}

// LoginForm is the gateway for school administrators
templ LoginForm() {
	<div class="max-w-md mx-auto mt-16 bg-background p-8 rounded-lg shadow-lg border border-border">
		<h2 class="text-2xl text-primary font-bold mb-6">Admin Login</h2>
		@form.Item(form.ItemProps{
			Class: "flex flex-col gap-4",
			Attributes: templ.Attributes{
				"action": "/login",
				"method": "POST",
			},
		}) {
			@label.Label(label.Props{For: "username"}) {
				Username
			}
			@input.Input(input.Props{
				ID:       "username",
				Name:     "username",
				Required: true,
				Type:     input.TypeText,
			})
			@label.Label(label.Props{For: "password"}) {
				Password
			}
			@input.Input(input.Props{
				ID:       "password",
				Name:     "password",
				Required: true,
				Type:     input.TypePassword,
			})
			@button.Button(button.Props{
				Type:  button.TypeSubmit,
				Class: "w-full",
			}) {
				Sign In
			}
		}
	</div>
}

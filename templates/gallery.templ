package templates

import (
	"github.com/NoahTek/emrs-website/internal/database"
	"strconv"
)

// Data struct defined right in the template file for clarity,
// though it can live in internal/models.
//type GalleryItem struct {
//	ID       int
//	Title    string
//	ImageURL string
//}

// GalleryCard generates a single image component
templ GalleryCard(item database.PhotoRecord) {
	<div class="bg-gray-800 rounded-lg overflow-hidden shadow-lg border border-gray-700">
		<img src={ item.ImageURL } alt={ item.Title } class="w-full h-48 object-cover"/>
		<div class="p-4">
			<h3 class="text-[#ebdbb2] font-bold">{ item.Title }</h3>
			<div class="mt-4 flex justify-between items-center">
				<span class="text-xs text-gray-400">ID: { strconv.Itoa(item.ID) }</span>
				<button
					hx-delete={ string(templ.URL("/admin/photo/" + strconv.Itoa(item.ID))) }
					hx-confirm="Are you sure you want to delete this photo?"
					hx-target="closest div.bg-gray-800"
					hx-swap="outerHTML"
					class="text-red-400 hover:text-red-500 text-sm font-semibold transition-colors"
				>
					Delete
				</button>
			</div>
		</div>
	</div>
}

// GalleryGrid is a container that loops through multiple items
templ GalleryGrid(items []database.PhotoRecord) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 p-6">
		for _, item := range items {
			@GalleryCard(item)
		}
	</div>
}
